<UserControl
    x:Class="Quiz.Views.JuegoView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Quiz.Converters"
    xmlns:selectors="clr-namespace:Quiz.Selectors">

    <UserControl.Resources>

        <!--  TEXTO  -->
        <DataTemplate x:Key="TextoTemplate">
            <Border
                Padding="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Contenido}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <!--  IMAGEN  -->
        <DataTemplate x:Key="ImagenTemplate">
            <Border
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10">
                <Image Source="{Binding Contenido}" Stretch="Uniform" />
            </Border>
        </DataTemplate>

        <!--  AUDIO  -->
        <DataTemplate x:Key="AudioTemplate">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">

                <Border
                    Padding="10"
                    Background="#FFFFFF22"
                    CornerRadius="50">
                    <TextBlock FontSize="32" Text="🔊" />
                </Border>

                <TextBlock
                    FontSize="14"
                    Foreground="White"
                    Text="Reproducir" />
            </StackPanel>
        </DataTemplate>

        <selectors:RespuestaTemplateSelector
            x:Key="RespuestaSelector"
            AudioTemplate="{StaticResource AudioTemplate}"
            ImagenTemplate="{StaticResource ImagenTemplate}"
            TextoTemplate="{StaticResource TextoTemplate}" />

        <conv:IndexVisibleConverter x:Key="IndexVisibleConverter" />

    </UserControl.Resources>

    <Grid>

        <!--  FONDO  -->
        <Image
            Opacity="0.3"
            Source="avares://Quiz/Assets/11587928_4786503.jpg"
            Stretch="UniformToFill" />

        <Grid Margin="20" RowDefinitions="Auto,Auto,*">

            <!--  HEADER  -->
            <StackPanel Grid.Row="0" Spacing="10">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="15">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#FFC107"
                        Text="{Binding PreguntaActual, StringFormat='Pregunta {0}/12'}" />
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="¡¡¡RESPONDE ANTES DE QUE LA BARRA LLEGUE A SU FIN!!!" />
                </StackPanel>

                <ProgressBar
                    Height="15"
                    Foreground="#51A7E0"
                    Maximum="15"
                    Value="{Binding TiempoRestante}" />
            </StackPanel>

            <!--  PREGUNTA  -->
            <Border
                Grid.Row="1"
                Margin="0,10"
                Padding="15"
                Background="#F2F2F2"
                CornerRadius="10">
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="{Binding Pregunta}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>

            <!--  RESPUESTAS  -->
            <UniformGrid
                Grid.Row="2"
                Margin="0,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Columns="2"
                Rows="2">

                <!--  🔵  -->
                <Button
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[0]}"
                    IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=0}">

                    <Border
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#01DDF5"
                        CornerRadius="12">

                        <Grid
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="▲" />

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Respuestas[0]}"
                                ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <!--  🟢  -->
                <Button
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[1]}"
                    IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=1}">

                    <Border
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#EF1F6B"
                        CornerRadius="12">

                        <Grid
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="◆" />

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Respuestas[1]}"
                                ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <!--  🔴  -->
                <Button
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[2]}"
                    IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=2}">

                    <Border
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#0B6354"
                        CornerRadius="12">

                        <Grid
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="●" />

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Respuestas[2]}"
                                ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <!--  🟣  -->
                <Button
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[3]}"
                    IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=3}">

                    <Border
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#08444E"
                        CornerRadius="12">

                        <Grid
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="■" />

                            <ContentControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding Respuestas[3]}"
                                ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

            </UniformGrid>

        </Grid>
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#80000000"
            IsVisible="{Binding MostrarResultado}"
            ZIndex="999">

            <Border
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{Binding ColorResultado}"
                CornerRadius="15">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding MensajeResultado}" />
            </Border>

        </Border>

        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#CC000000"
            IsVisible="{Binding MostrarEstadisticas}"
            ZIndex="998">

            <Border
                Width="400"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#222"
                CornerRadius="15">

                <StackPanel Spacing="10">

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="📊 Estadísticas" />

                    <ItemsControl ItemsSource="{Binding Estadisticas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="5"
                                    Padding="10"
                                    Background="#333"
                                    CornerRadius="8">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock Foreground="White" Text="{Binding Nombre}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="Bold"
                                            Foreground="#4CAF50"
                                            Text="{Binding Puntos}" />

                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        Margin="0,20,0,0"
                        Padding="20,10"
                        HorizontalAlignment="Center"
                        Background="#F44336"
                        Command="{Binding VolverCommand}"
                        Content="Salir"
                        FontWeight="Bold"
                        Foreground="White"
                        IsVisible="{Binding JuegoTerminado}" />

                </StackPanel>

            </Border>

        </Border>
    </Grid>
</UserControl>
