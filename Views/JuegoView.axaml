<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="clr-namespace:Quiz.ViewModels"
xmlns:selectors="clr-namespace:Quiz.Selectors"
x:Class="Quiz.Views.JuegoView">


    <!-- 🔧 TEMPLATES + SELECTOR -->
    <UserControl.Resources>

        <!-- TEXTO -->
        <DataTemplate x:Key="TextoTemplate">
            <TextBlock Text="{Binding Contenido}"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       MaxWidth="300"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- IMAGEN -->
        <DataTemplate x:Key="ImagenTemplate">
            <Image Source="{Binding Contenido}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>
        </DataTemplate>

        <!-- AUDIO -->
        <DataTemplate x:Key="AudioTemplate">
            <Border Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">

                    <TextBlock Text="🔊"
                               FontSize="40"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Reproducir"
                               FontSize="16"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>
        </DataTemplate> 

        <!-- SELECTOR -->
        <selectors:RespuestaTemplateSelector x:Key="RespuestaSelector"
                                             TextoTemplate="{StaticResource TextoTemplate}"
                                             ImagenTemplate="{StaticResource ImagenTemplate}"
                                             AudioTemplate="{StaticResource AudioTemplate}"/>

    </UserControl.Resources>



    <!-- 🔳 UI -->
    <Grid RowDefinitions="Auto,Auto,*"
          Margin="20">

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="10">

            <TextBlock Text="Wikipedia"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <ProgressBar Value="{Binding TiempoRestante}"
                         Maximum="15"
                         Height="15"/>
        </StackPanel>

        <!-- PREGUNTA -->
        <Border Grid.Row="1"
                Background="#F2F2F2"
                CornerRadius="10"
                Padding="15"
                Margin="0,10">

            <TextBlock Text="{Binding Pregunta}"
                       Foreground="Black"
                       FontSize="26"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Border>

        <!-- RESPUESTAS -->
        <UniformGrid Grid.Row="2"
                     Rows="2"
                     Columns="2"
                     Margin="0,20"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">

            <!-- 🔵 -->
            <Button Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[0]}"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <Border Background="#3A5A80" CornerRadius="12">
                    <Grid>
                        <TextBlock Text="▲"
                                   Foreground="White"
                                   Margin="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <ContentControl Content="{Binding Respuestas[0]}"
                                        ContentTemplate="{StaticResource RespuestaSelector}"/>
                    </Grid>
                </Border>
            </Button>

            <!-- 🟢 -->
            <Button Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[1]}"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <Border Background="#3E6F64" CornerRadius="12">
                    <Grid>
                        <TextBlock Text="◆"
                                   Foreground="White"
                                   Margin="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <ContentControl Content="{Binding Respuestas[1]}"
                                        ContentTemplate="{StaticResource RespuestaSelector}"/>
                    </Grid>
                </Border>
            </Button>

            <!-- 🔴 -->
            <Button Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[2]}"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <Border Background="#6A3B3F" CornerRadius="12">
                    <Grid>
                        <TextBlock Text="●"
                                   Foreground="White"
                                   Margin="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <ContentControl Content="{Binding Respuestas[2]}"
                                        ContentTemplate="{StaticResource RespuestaSelector}"/>
                    </Grid>
                </Border>
            </Button>

            <!-- 🟣 -->
            <Button Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="{Binding Respuestas[3]}"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <Border Background="#4B3B6F" CornerRadius="12">
                    <Grid>
                        <TextBlock Text="■"
                                   Foreground="White"
                                   Margin="10"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <ContentControl Content="{Binding Respuestas[3]}"
                                        ContentTemplate="{StaticResource RespuestaSelector}"/>
                    </Grid>
                </Border>
            </Button>

        </UniformGrid>

    </Grid>
</UserControl>