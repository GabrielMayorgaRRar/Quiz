<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:selectors="clr-namespace:Quiz.Selectors"
xmlns:conv="clr-namespace:Quiz.Converters"
x:Class="Quiz.Views.JuegoView">

    <UserControl.Resources>

        <!-- TEXTO -->
        <DataTemplate x:Key="TextoTemplate">
            <Border Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <TextBlock Text="{Binding Contenido}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- IMAGEN -->
        <DataTemplate x:Key="ImagenTemplate">
            <Border CornerRadius="10"
                    ClipToBounds="True"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Image Source="{Binding Contenido}"
                       Stretch="Uniform"/>
            </Border>
        </DataTemplate>

        <!-- AUDIO -->
        <DataTemplate x:Key="AudioTemplate">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <Border Background="#FFFFFF22"
                        CornerRadius="50"
                        Padding="10">
                    <TextBlock Text="🔊"
                               FontSize="32"/>
                </Border>

                <TextBlock Text="Reproducir"
                           Foreground="White"
                           FontSize="14"/>
            </StackPanel>
        </DataTemplate>

        <selectors:RespuestaTemplateSelector x:Key="RespuestaSelector"
                                             TextoTemplate="{StaticResource TextoTemplate}"
                                             ImagenTemplate="{StaticResource ImagenTemplate}"
                                             AudioTemplate="{StaticResource AudioTemplate}"/>

        <conv:IndexVisibleConverter x:Key="IndexVisibleConverter"/>

    </UserControl.Resources>

    <Grid>

        <!-- FONDO -->
        <Image Source="avares://Quiz/Assets/11587928_4786503.jpg"
               Stretch="UniformToFill"
               Opacity="0.3"/>

        <Grid RowDefinitions="Auto,Auto,*" Margin="20">

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Spacing="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                    <TextBlock Text="{Binding PreguntaActual, StringFormat='Pregunta {0}/12'}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFC107"/>
                    <TextBlock Text="¡¡¡RESPONDE ANTES DE QUE LA BARRA LLEGUE A SU FIN!!!"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

                <ProgressBar Value="{Binding TiempoRestante}"
                             Maximum="15"
                             Height="15"
                             Foreground="#51A7E0"/>
            </StackPanel>

            <!-- PREGUNTA -->
            <Border Grid.Row="1"
                    Background="#F2F2F2"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,10">
                <TextBlock Text="{Binding Pregunta}"
                           Foreground="Black"
                           FontSize="26"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

            <!-- RESPUESTAS -->
            <UniformGrid Grid.Row="2"
                         Rows="2"
                         Columns="2"
                         Margin="0,20"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">

                <!-- 🔵 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[0]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=0}"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <Border Background="#01DDF5"
                            CornerRadius="12"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <Grid Margin="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <TextBlock Text="▲"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[0]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🟢 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[1]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=1}"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <Border Background="#EF1F6B"
                            CornerRadius="12"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <Grid Margin="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <TextBlock Text="◆"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[1]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🔴 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[2]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=2}"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <Border Background="#0B6354"
                            CornerRadius="12"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <Grid Margin="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <TextBlock Text="●"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[2]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🟣 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[3]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=3}"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                    <Border Background="#08444E"
                            CornerRadius="12"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <Grid Margin="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <TextBlock Text="■"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[3]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Button>

            </UniformGrid>

        </Grid>
        <Border Background="#80000000"
                IsVisible="{Binding MostrarResultado}"
                ZIndex="999"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="15"
                    Padding="30"
                    Background="{Binding ColorResultado}">

                <TextBlock Text="{Binding MensajeResultado}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </Border>

        <Border Background="#CC000000"
                IsVisible="{Binding MostrarEstadisticas}"
                ZIndex="998"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border Background="#222"
                    CornerRadius="15"
                    Padding="20"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="10">

                    <TextBlock Text="📊 Estadísticas"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <ItemsControl ItemsSource="{Binding Estadisticas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#333"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="5">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock Text="{Binding Nombre}"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding Puntos}"
                                                   Foreground="#4CAF50"
                                                   Grid.Column="1"
                                                   FontWeight="Bold"/>

                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <Button Content="Salir"
                        Command="{Binding VolverCommand}"
                        IsVisible="{Binding JuegoTerminado}"
                        HorizontalAlignment="Center"
                        Background="#F44336"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="20,10"
                        Margin="0,20,0,0"/>

            </Border>

        </Border>
    </Grid>
</UserControl>