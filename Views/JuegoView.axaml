<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="clr-namespace:Quiz.ViewModels"
xmlns:selectors="clr-namespace:Quiz.Selectors"
xmlns:conv="clr-namespace:Quiz.Converters"
x:Class="Quiz.Views.JuegoView">

    <!-- 🔧 RECURSOS -->
    <UserControl.Resources>

        <!-- TEXTO -->
        <DataTemplate x:Key="TextoTemplate">
            <TextBlock Text="{Binding Contenido}"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       MaxWidth="300"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- IMAGEN -->
        <DataTemplate x:Key="ImagenTemplate">
            <Image Source="{Binding Contenido}"
                   Stretch="UniformToFill"/>
        </DataTemplate>

        <!-- AUDIO -->
        <DataTemplate x:Key="AudioTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔊" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Reproducir" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- SELECTOR -->
        <selectors:RespuestaTemplateSelector x:Key="RespuestaSelector"
                                             TextoTemplate="{StaticResource TextoTemplate}"
                                             ImagenTemplate="{StaticResource ImagenTemplate}"
                                             AudioTemplate="{StaticResource AudioTemplate}"/>

        <!-- CONVERTER -->
        <conv:IndexVisibleConverter x:Key="IndexVisibleConverter"/>

    </UserControl.Resources>

    <!-- 🔥 CONTENEDOR -->
    <Grid>

        <!-- 🖼️ FONDO -->
        <Image Source="avares://Quiz/Assets/11587928_4786503.jpg"
               Stretch="UniformToFill"
               Opacity="0.3"/>

        <Grid RowDefinitions="Auto,Auto,*"
              Margin="20">

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Spacing="10">

                <TextBlock Text="Wikipedia"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <ProgressBar Value="{Binding TiempoRestante}"
                             Maximum="15"
                             Height="15"
                             Foreground="#51A7E0"/>
            </StackPanel>

            <!-- PREGUNTA -->
            <Border Grid.Row="1"
                    Background="#F2F2F2"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,10">

                <TextBlock Text="{Binding Pregunta}"
                           Foreground="Black"
                           FontSize="26"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

            <!-- RESPUESTAS -->
            <UniformGrid Grid.Row="2"
                         Rows="2"
                         Columns="2"
                         Margin="0,20">

                <!-- 🔵 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[0]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=0}"
                        Margin="10">

                    <Border Background="#01DDF5" CornerRadius="12">
                        <Grid>
                            <TextBlock Text="▲"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[0]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🟢 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[1]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=1}"
                        Margin="10">

                    <Border Background="#EF1F6B" CornerRadius="12">
                        <Grid>
                            <TextBlock Text="◆"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[1]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🔴 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[2]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=2}"
                        Margin="10">

                    <Border Background="#0B6354" CornerRadius="12">
                        <Grid>
                            <TextBlock Text="●"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[2]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 🟣 -->
                <Button Command="{Binding SeleccionarRespuestaCommand}"
                        CommandParameter="{Binding Respuestas[3]}"
                        IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=3}"
                        Margin="10">

                    <Border Background="#08444E" CornerRadius="12">
                        <Grid>
                            <TextBlock Text="■"
                                       Foreground="White"
                                       Margin="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                            <ContentControl Content="{Binding Respuestas[3]}"
                                            ContentTemplate="{StaticResource RespuestaSelector}"/>
                        </Grid>
                    </Border>
                </Button>

            </UniformGrid>

        </Grid>
    </Grid>
</UserControl>