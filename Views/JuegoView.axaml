<UserControl
x:Class="Quiz.Views.JuegoView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:conv="clr-namespace:Quiz.Converters"
xmlns:selectors="clr-namespace:Quiz.Selectors">

    <UserControl.Resources>

        <DataTemplate x:Key="TextoTemplate">
            <Border
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
                <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding Contenido}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImagenTemplate">
            <Panel Margin="10">
                <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10">
                    <Image Source="{Binding Imagen}" Stretch="Uniform" />
                </Border>
                <Border 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="8" 
                Background="#AA000000" 
                CornerRadius="6" 
                Padding="6,2">
                    <TextBlock Text="Imagen" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
            </Panel>
        </DataTemplate>

        <DataTemplate x:Key="AudioTemplate">
            <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

                <TextBlock FontSize="40" Foreground="White" Text="🎵" HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button
                    Width="48"
                    Height="48"
                    Background="#FFFFFF22"
                    CornerRadius="24"
                    Click="OnInnerButtonClick"
                    Command="{Binding $parent[UserControl].DataContext.ReproducirAudioCommand}"
                    CommandParameter="{Binding Contenido}">
                        <TextBlock FontSize="20" Foreground="White" Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button
                    Width="48"
                    Height="48"
                    Background="#FFFFFF22"
                    CornerRadius="24"
                    Click="OnInnerButtonClick"
                    Command="{Binding $parent[UserControl].DataContext.StopAudioCommand}">
                        <TextBlock FontSize="20" Foreground="White" Text="⏸" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Text="Audio"
                HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <selectors:RespuestaTemplateSelector
        x:Key="RespuestaSelector"
        AudioTemplate="{StaticResource AudioTemplate}"
        ImagenTemplate="{StaticResource ImagenTemplate}"
        TextoTemplate="{StaticResource TextoTemplate}" />

        <conv:IndexVisibleConverter x:Key="IndexVisibleConverter" />

    </UserControl.Resources>

    <Grid>

        <Image
        Opacity="0.3"
        Source="avares://Quiz/Assets/11587928_4786503.jpg"
        Stretch="UniformToFill" />

        <Grid Margin="20" RowDefinitions="Auto,Auto,*">

            <StackPanel Grid.Row="0" Spacing="12">

                <Border
                Padding="15"
                Background="#AA000000"
                CornerRadius="14">

                    <StackPanel Spacing="8">

                        <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#78D874"
                        Text="{Binding PreguntaActual, StringFormat='Pregunta {0} de 12'}" />

                        <Border
                        Padding="6,3"
                        Background="#22FFFFFF"
                        CornerRadius="8"
                        HorizontalAlignment="Center">

                            <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="⏳ ¡Apresúrate! El tiempo se está acabando"
                            TextAlignment="Center" />
                        </Border>

                    </StackPanel>
                </Border>

                <Grid>

                    <Border
                    Height="20"
                    Background="#222"
                    CornerRadius="12" />

                    <ProgressBar
                    Height="20"
                    Maximum="15"
                    Value="{Binding TiempoRestante}"
                    Background="#00196B75"
                    Foreground="#EE00A5BB"
                    CornerRadius="12" />

                    <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding TiempoRestante, StringFormat='{}{0}s'}" />

                </Grid>

            </StackPanel>

            <Border
            Grid.Row="1"
            Margin="0,10"
            Padding="15"
            Background="#F2F2F2"
            CornerRadius="10">
                <TextBlock
                FontSize="26"
                FontWeight="Bold"
                Foreground="Black"
                Text="{Binding Pregunta}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </Border>

            <UniformGrid
            Grid.Row="2"
            Margin="0,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Columns="2"
            Rows="2">

                <Button
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SeleccionarRespuestaCommand}"
                CommandParameter="{Binding Respuestas[0]}"
                IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=0}">

                    <Border
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#01DDF5"
                    CornerRadius="12">

                        <Grid
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                            <TextBlock
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="White"
                            Text="▲" />

                            <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding Respuestas[0]}"
                            ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <Button
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SeleccionarRespuestaCommand}"
                CommandParameter="{Binding Respuestas[1]}"
                IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=1}">

                    <Border
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#EF1F6B"
                    CornerRadius="12">

                        <Grid
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                            <TextBlock
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="White"
                            Text="◆" />

                            <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding Respuestas[1]}"
                            ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <Button
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SeleccionarRespuestaCommand}"
                CommandParameter="{Binding Respuestas[2]}"
                IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=2}">

                    <Border
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#0B6354"
                    CornerRadius="12">

                        <Grid
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                            <TextBlock
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="White"
                            Text="●" />

                            <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding Respuestas[2]}"
                            ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

                <Button
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SeleccionarRespuestaCommand}"
                CommandParameter="{Binding Respuestas[3]}"
                IsVisible="{Binding Respuestas.Count, Converter={StaticResource IndexVisibleConverter}, ConverterParameter=3}">

                    <Border
                    Padding="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#08444E"
                    CornerRadius="12">

                        <Grid
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                            <TextBlock
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="White"
                            Text="■" />

                            <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding Respuestas[3]}"
                            ContentTemplate="{StaticResource RespuestaSelector}" />
                        </Grid>
                    </Border>
                </Button>

            </UniformGrid>

        </Grid>
        <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#80000000"
        IsVisible="{Binding MostrarResultado}"
        ZIndex="999">

            <Border
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{Binding ColorResultado}"
            CornerRadius="15">

                <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding MensajeResultado}" />
            </Border>

        </Border>

        <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#7E000000"
        IsVisible="{Binding MostrarEstadisticas}"
        ZIndex="998">

            <Border
            Width="400"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="15">

                <StackPanel Spacing="12">

                    <Border
                    Padding="10"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center">

                        <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="Black"
                        Text="Estadísticas" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Estadisticas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                Margin="5"
                                Padding="12"
                                Background="#C7ACACAC"
                                CornerRadius="10">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <!-- NOMBRE -->
                                        <TextBlock
                                        Foreground="#CF45CF"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Nombre}" />

                                        <!-- PUNTOS -->
                                        <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        Background="#4CAF50"
                                        CornerRadius="8">

                                            <TextBlock
                                            Foreground="Black"
                                            FontWeight="Bold"
                                            Text="{Binding Puntos}" />
                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                    Margin="0,15,0,0"
                    Padding="20,10"
                    HorizontalAlignment="Center"
                    Background="#F836BE"
                    Command="{Binding VolverCommand}"
                    FontWeight="Bold"
                    Foreground="White"
                    IsVisible="{Binding JuegoTerminado}">

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="X"/>
                            <TextBlock Text="Salir"/>
                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

        </Border>
    </Grid>
</UserControl>
