<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:converters="using:Quiz.Converters"
x:Class="Quiz.Views.CrearSalaView">

    <UserControl.Styles>
        <Style Selector="TextBox.input">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox.input:focus">
            <Setter Property="BorderBrush" Value="#E05FAA"/>
        </Style>

        <Style Selector="ComboBox.input">
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="10">

                        <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextElement.Foreground="{TemplateBinding Foreground}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.btnPrimary">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E05FAA"/>

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btnPrimary:pointerover">
            <Setter Property="Background" Value="#F07BC0"/>
            <Setter Property="Height" Value="65"/>
        </Style>

        <Style Selector="Button.btnPrimary:pressed">
            <Setter Property="Background" Value="#C94F98"/>
            <Setter Property="Height" Value="50"/>
        </Style>

        <Style Selector="Button.btnSecondary">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>

            <Setter Property="Background" Value="#8282DD"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.btnSecondary:pointerover">
            <Setter Property="Background" Value="#8282DD"/>
        </Style>

        <Style Selector="Button.btnSecondary:pressed">
            <Setter Property="Background" Value="#AFAFFF"/>
        </Style>

        <Style Selector="Button.btnBack">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="#4AE9E9"/>

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>

        </Style>

        <Style Selector="Button.btnBack:pointerover">
            <Setter Property="Background" Value="#47D8D8"/>
            <Setter Property="Height" Value="45"/>
        </Style>

        <Style Selector="Button.btnBack:pressed">
            <Setter Property="Background" Value="#3BC0C0"/>
            <Setter Property="Height" Value="32"/>
        </Style>

    </UserControl.Styles>

    <Grid>
        <Image
        Source="avares://Quiz/Assets/4394250_91648.jpg"
        Stretch="UniformToFill"
        Opacity="0.35"/>

        <Border Background="#55000000"/>

        <Border
        Width="550"
        Padding="30"
        CornerRadius="20"
        Background="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Button
                Content="← Volver"
                Classes="btnBack"
                Command="{Binding VolverCommand}"
                Margin="0,0,0,10"/>

                <TextBlock
                Text="CREAR SALA"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

                <TextBox Watermark="Nombre de la sala" Text="{Binding NombreSala}" Classes="input"/>
                <TextBox Watermark="Nombre" Text="{Binding Nombre}" Classes="input"/>
                <TextBox Watermark="Apodo" Text="{Binding Apodo}" Classes="input"/>

                <ListBox ItemsSource="{Binding Avatares}" SelectedItem="{Binding AvatarSeleccionado}" Background="Transparent" Margin="0" Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="50" Height="50" CornerRadius="25" ClipToBounds="True">
                                <Image Source="{Binding Imagen}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="CornerRadius" Value="30" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="BorderBrush" Value="#E05FAA" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>

                <ListBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" Background="Transparent" Margin="0" Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F4F4F5" CornerRadius="16" Padding="12,6" BorderBrush="#E4E4E7" BorderThickness="1" x:Name="ChipBorder">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" x:Name="ChipText" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected Border#ChipBorder">
                            <Setter Property="Background" Value="#E05FAA" />
                            <Setter Property="BorderBrush" Value="#E05FAA" />
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock#ChipText">
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBox
                    Width="250"
                    Text="{Binding CodigoSala}"
                    IsReadOnly="True"
                    Classes="input"/>

                    <Button
                    Content="{Binding TextoCopiar}"
                    Command="{Binding CopiarCodigoCommand}"
                    Classes="btnSecondary"/>
                </StackPanel>

                <Button
                Content="CREAR"
                Classes="btnPrimary"
                Command="{Binding CrearSalaCommand}"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>