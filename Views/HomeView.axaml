<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
x:Class="Quiz.Views.HomeView">

    <UserControl.Styles>

        <!-- 🔥 TEMPLATE PROPIO (elimina efecto blanco del tema) -->
        <Style Selector="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextElement.Foreground="{TemplateBinding Foreground}"/>

                    </Border>
                </ControlTemplate>
            </Setter>

            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 🔥 CREAR -->
        <Style Selector="Button#BtnCrear">
            <Setter Property="Background" Value="#E05FAA"/>
        </Style>

        <Style Selector="Button#BtnCrear:pointerover">
            <Setter Property="Background" Value="#F07BC0"/>
            <Setter Property="Height" Value="55"/>
        </Style>

        <Style Selector="Button#BtnCrear:pressed">
            <Setter Property="Background" Value="#C94F98"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- 🔥 UNIRSE -->
        <Style Selector="Button#BtnUnirse">
            <Setter Property="Background" Value="#505DCE"/>
        </Style>

        <Style Selector="Button#BtnUnirse:pointerover">
            <Setter Property="Background" Value="#6A75E0"/>
            <Setter Property="Height" Value="55"/>
        </Style>

        <Style Selector="Button#BtnUnirse:pressed">
            <Setter Property="Background" Value="#3F49A8"/>
            <Setter Property="Height" Value="40"/>
        </Style>

    </UserControl.Styles>

    <Grid>

        <!-- Fondo -->
        <Image
        Source="avares://Quiz/Assets/4167598.jpg"
        Stretch="UniformToFill"
        Opacity="0.4"/>

        <!-- Overlay -->
        <Border Background="#66000000"/>

        <!-- Card -->
        <Border
        Width="320"
        Padding="30"
        Background="#CCFFFFFF"
        CornerRadius="15"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <StackPanel
            Spacing="15"
            HorizontalAlignment="Center">

                <TextBlock
                Text="QUIZ MASTER"
                FontSize="26"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                TextAlignment="Center"/>

                <Button
                x:Name="BtnCrear"
                Content="CREAR SALA"/>

                <Button
                x:Name="BtnUnirse"
                Content="UNIRSE"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>