<UserControl
    x:Class="Quiz.Features.Juegos.JuegoView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Quiz.Features.Juegos"
    x:DataType="vm:JuegoViewModel"
    Background="#FAFAF9"
    FontFamily="Inter, Roboto, sans-serif"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="Georgia, Times New Roman, serif" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New, monospace" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D6D3D1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Foreground" Value="#433829" />
            <Setter Property="CaretBrush" Value="#433829" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#E07A5F" />
            <Setter Property="Background" Value="#05E07A5F" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D6D3D1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="#433829" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#E07A5F" />
            <Setter Property="Foreground" Value="#FAFAF9" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#C25A3F" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#78716C" />
            <Setter Property="BorderBrush" Value="#D6D3D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#F5F5F4" />
            <Setter Property="Foreground" Value="#433829" />
        </Style>

        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#BC4749" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#BC4749" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.destructive:pointerover">
            <Setter Property="Background" Value="#0ABC4749" />
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="#2A9D8F" />
            <Setter Property="Foreground" Value="#FAFAF9" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.success:pointerover">
            <Setter Property="Background" Value="#21867A" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#FAFAF9" />
            <Setter Property="BorderBrush" Value="#D6D3D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#FAFAF9" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7E5E4" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F4" />
            <Setter Property="Foreground" Value="#78716C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#D6D3D1" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Foreground" Value="#433829" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="40" ColumnDefinitions="450,*">
        <!-- COLUMNA IZQUIERDA: Formulario de creación -->
        <Border
            Grid.Column="0"
            Padding="0,0,40,0"
            BorderBrush="#D6D3D1"
            BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,24" Spacing="32">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Classes="mono"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#D4A373"
                            LetterSpacing="1"
                            Text="PARTIDAS" />
                        <TextBlock
                            Classes="serif"
                            FontSize="32"
                            Foreground="#433829"
                            LineHeight="40"
                            Text="Registrar Nueva Partida"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="14"
                            Foreground="#78716C"
                            LineHeight="22"
                            Text="Diseña un espacio de juego y distribuye la clave secreta a los participantes."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Background="#E7E5E4" />

                    <StackPanel Spacing="24">

                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="mono"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#A8A29E"
                                LetterSpacing="1"
                                Text="NOMBRE DEL JUEGO" />
                            <TextBox
                                FontSize="15"
                                Text="{Binding Nombre}"
                                Watermark="Ej. Desafío de Historia Fase 1..." />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="mono"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#A8A29E"
                                LetterSpacing="1"
                                Text="TÓPICO A EVALUAR" />
                            <ComboBox
                                DisplayMemberBinding="{Binding Nombre}"
                                ItemsSource="{Binding Categorias}"
                                PlaceholderText="Seleccione una categoría guardada..."
                                SelectedItem="{Binding CategoriaSeleccionada}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Classes="mono"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#E07A5F"
                                    LetterSpacing="1"
                                    Text="CLAVE DE ACCESO AUTOGENERADA" />
                                <Button
                                    Grid.Column="1"
                                    Padding="8,4"
                                    Classes="secondary"
                                    Command="{Binding RefrescarClaveCommand}"
                                    CornerRadius="4">
                                    <TextBlock
                                        Classes="mono"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Text="↻ REFRESCAR" />
                                </Button>
                            </Grid>

                            <Border
                                Padding="16,16"
                                Background="#F5F5F4"
                                BorderBrush="#D6D3D1"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="mono"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#433829"
                                    LetterSpacing="4"
                                    Text="{Binding Clave}" />
                            </Border>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="#A8A29E"
                                Text="Esta clave ha sido generada aleatoriamente utilizando el tiempo actual para asegurar su unicidad."
                                TextWrapping="Wrap" />
                        </StackPanel>

                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="32,0"
                        HorizontalAlignment="Stretch"
                        Background="#E7E5E4" />

                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Classes="primary"
                        Command="{Binding AgregarCommand}">
                        <TextBlock
                            Classes="mono"
                            FontSize="12"
                            FontWeight="Bold"
                            LetterSpacing="1"
                            Text="APERTURAR SALA" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- COLUMNA DERECHA: Listado, unión y juego activo -->
        <Grid Grid.Column="1" Margin="40,0,0,0" RowDefinitions="Auto,*,Auto,Auto,Auto">
            
            <Grid Grid.Row="0" Margin="0,0,0,24" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Classes="serif"
                        FontSize="24"
                        Foreground="#433829"
                        Text="Registro de Partidas" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="14"
                        Foreground="#78716C"
                        Text="Monitoreo de todos los juegos creados en la plataforma." />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="destructive"
                    Command="{Binding EliminarCommand}"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#BC4749"
                            Text="✕" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="mono"
                            FontSize="11"
                            FontWeight="Bold"
                            LetterSpacing="1"
                            Text="EXPIRAR SELECCIÓN" />
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Juegos}"
                SelectedItem="{Binding JuegoSeleccionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Id}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Nombre}"
                        Header="NOMBRE DEL JUEGO" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Clave}"
                        Header="CLAVE" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Estado}"
                        Header="ESTADO" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding FechaCreacion, StringFormat=\{0:dd/MM/yy\}}"
                        Header="CREACIÓN" />
                    <DataGridTemplateColumn Width="90" Header="ACCIÓN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Classes="primary"
                                    Padding="12,6"
                                    Command="{Binding $parent[UserControl].DataContext.IniciarJuegoCommand}">
                                    <TextBlock FontSize="11" Text="▶ INICIAR" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- SECCIÓN: Unirse a sala -->
            <Border
                Grid.Row="2"
                Margin="0,24,0,0"
                Padding="20"
                Background="#F5F5F4"
                BorderBrush="#D6D3D1"
                BorderThickness="1"
                CornerRadius="16">
                
                <StackPanel Spacing="16">
                    <TextBlock
                        Classes="serif"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#433829"
                        Text="🎮 Unirse a una partida" />
                    
                    <Grid ColumnDefinitions="*,15,*">
                        <TextBox
                            Grid.Column="0"
                            Watermark="Código de sala (ej: 260308-153045)"
                            Text="{Binding CodigoSala}" />
                        
                        <TextBox
                            Grid.Column="2"
                            Watermark="Tu nickname"
                            Text="{Binding Nickname}" />
                    </Grid>
                    
                    <Button
                        HorizontalAlignment="Stretch"
                        Classes="success"
                        Command="{Binding UnirseASalaCommand}">
                        <TextBlock
                            Classes="mono"
                            FontSize="12"
                            FontWeight="Bold"
                            LetterSpacing="1"
                            Text="🚪 UNIRSE A LA SALA" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: Juego activo -->
            <Border
                Grid.Row="3"
                Margin="0,24,0,0"
                Padding="20"
                Background="White"
                BorderBrush="#E07A5F"
                BorderThickness="2"
                CornerRadius="16"
                IsVisible="{Binding EnJuego}">
                
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock
                            Grid.Column="0"
                            Classes="serif"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#E07A5F"
                            Text="🎯 ¡EN JUEGO!" />
                        
                        <Border Grid.Column="1" Background="#E07A5F" CornerRadius="20" Padding="12,6">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White">
                                <Run Text="Puntaje: "/>
                                <Run Text="{Binding MiParticipacion.Puntos}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                    
                    <TextBlock FontSize="12" Foreground="#78716C">
                        <Run Text="Pregunta "/>
                        <Run Text="{Binding PreguntaActualIndex, Mode=OneWay}"/>
                        <Run Text=" de "/>
                        <Run Text="{Binding Preguntas.Count, Mode=OneWay}"/>
                    </TextBlock>
                    
                    <Border
                        Padding="16"
                        Background="#F5F5F4"
                        CornerRadius="12">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#433829"
                            Text="{Binding PreguntaTexto}"
                            TextWrapping="Wrap" />
                    </Border>
                    
                    <ItemsControl ItemsSource="{Binding Opciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,6,0,0"
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch"
                                    Classes="secondary"
                                    Command="{Binding $parent[UserControl].DataContext.ResponderCommand}"
                                    CommandParameter="{Binding}">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="#433829"
                                        Text="{Binding Contenido}"
                                        TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mensajes -->
            <TextBlock
                Grid.Row="4"
                Margin="0,16,0,0"
                Padding="12"
                FontSize="13"
                Foreground="#92400E"
                Background="#FEF3C7"
                Text="{Binding Mensaje}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>